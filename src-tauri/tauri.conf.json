{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WT Content Manager",
  "version": "0.13.0",
  "identifier": "dev.wtcontentmanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 5175 --strictPort",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "WT Content Manager", "width": 1180, "height": 780, "minWidth": 720, "minHeight": 560, "decorations": false }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://live.warthunder.com; img-src 'self' data: asset: https://*.warthunder.com https://images-live.warthunder.com; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WT Content Manager",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true
      }
    }
  }
}

